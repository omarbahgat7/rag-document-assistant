# Copy this file to .env and fill in values as needed.
# All fields have working defaults matching Phase 2 — only ANTHROPIC_API_KEY
# is something you'll likely want to actually set.

# --- Vector store (must match Phase 2 ingestion exactly) ---
VECTOR_STORE_PATH=./data/vector_store
COLLECTION_NAME=document_assistant
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Retrieval ---
DEFAULT_TOP_K=4
MAX_TOP_K=20

# --- Generation (optional; without this, /query falls back to returning the
# top retrieved chunk instead of a real LLM answer) ---
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-4-6
GENERATION_MAX_TOKENS=500

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*
